{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_TOKEN": "ghp_placeholder" }
    },
    "filesystem-pinned": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@0.6.2"],
      "env": {}
    },
    "traffic-stats": {
      "command": "npx",
      "args": ["-y", "mcp-server-traffic-stats"],
      "env": { "SOME_KEY": "x" }
    },
    "legacy-db": {
      "command": "pipx",
      "args": ["run", "mcp-atlassian==0.12.0"]
    },
    "pinned-writer": {
      "command": "uvx",
      "args": ["mcp-write-gate@1.4.0"]
    },
    "db-container": {
      "command": "docker",
      "args": ["run", "--rm", "postgres:latest"]
    },
    "trusted-local": {
      "command": ["python", "./servers/local_only.py"]
    },
    "public-relay": {
      "url": "https://pipeline.api.com/mcp"
    }
  }
}